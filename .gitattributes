# Normalize text files to LF on every platform.
* text=auto eol=lf

# tools/serve.bat must keep CRLF, or cmd.exe can misread it.
*.bat text eol=crlf

# Binary files are never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
