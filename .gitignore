Gemfile.lock

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/

# Python
__pycache__/

# Reference material kept locally, never published
Command_Conquer_Renegade_Prima_Official_eGuide.pdf
/BRenBot-master
/brenbot

